# 秘密情報と起動の設定
# setup.bat を実行すると、このファイルをもとに .env が作られます。
# 秘密情報は、管理画面の「設定」→「秘密情報」からも入力できます（そのほうがかんたん）。
# .env はGitに入りません（APIキーやパスワードを外に出さないため）。

# Euler Stream の APIキー（無料のCommunityプラン）
EULER_API_KEY=

# Minecraft の RCON のパスワード（server.properties の rcon.password と同じもの）
MINECRAFT_RCON_PASSWORD=

# OBS WebSocket のパスワード（フェーズ2で使います）
OBS_WEBSOCKET_PASSWORD=

# 本体のポート番号（ふつうは変えません。変えると、OBSに入れたURLも変わります）
# PORT=3939

# 配信の記録（データベース）と設定を置くフォルダ（ふつうは変えません）
# 何も書かなければ %LOCALAPPDATA%\TikTokLiveTool になります
# DATA_DIR=
